# Copy to .env.local and fill in from Supabase: Project Settings → API (or the Connect button).
# Only the *publishable* key belongs here. Never put the secret / service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
